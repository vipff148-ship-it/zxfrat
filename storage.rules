// Template rules untuk Firebase Storage.
// Sesuaikan dengan Firebase Authentication/UID project kamu.
// Jangan membuka storage secara publik di production.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photoShares/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
